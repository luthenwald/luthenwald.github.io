cabal-version: 3.0
name:          site
version:       0.1.0
build-type:    Simple
data-files:    assets/reset.css, assets/prima.css

executable site
   default-language: GHC2024
   hs-source-dirs:   src
   main-is:          Main.hs
   ghc-options:      -Wall -O2
   default-extensions:
      OverloadedStrings
      LambdaCase
   other-modules:
      Typ
      Cfg
      Scn
      Ext
      Met
      Mrk
      Hlt
      Htm
      Rss
      Bld
      Paths_site
   autogen-modules:
      Paths_site
   build-depends:
      base                 >= 4.18,
      text                 >= 2.0,
      megaparsec           >= 9.0,
      blaze-html           >= 0.9,
      blaze-markup         >= 0.8,
      typed-process        >= 0.2,
      directory            >= 1.3,
      filepath             >= 1.4,
      time                 >= 1.12,
      base64-bytestring    >= 1.2,
      optparse-applicative >= 0.18,
      containers           >= 0.6,
      bytestring           >= 0.11
